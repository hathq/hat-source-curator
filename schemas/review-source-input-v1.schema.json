{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat-source-curator/review-source-input/v1",
  "title": "Source Curator input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope_ref",
    "revision",
    "subject_refs"
  ],
  "properties": {
    "schema": {
      "const": "hathq://hat-source-curator/review-source-input/v1"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "subject_refs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string"
      }
    }
  }
}
